{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Next.js compiles with its own bundler; source-level NodeNext resolution
    // does not apply inside the app.
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "resolveJsonModule": true
  },
  "include": [
    "*.mjs",
    "*.ts",
    "e2e",
    "next-env.d.ts",
    "src",
    "tests",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}

# IntentVisible environment template
# Copy to .env and fill in real values. Never commit real credentials.
# Values below are placeholders only.

# PostgreSQL connection for the API app (apps/api)
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Shopify connector credentials (apps/shopify-connector)
SHOPIFY_CLIENT_ID=<your-client-id>
SHOPIFY_CLIENT_SECRET=<your-client-secret>
SHOPIFY_WEBHOOK_SECRET=<your-webhook-secret>

# Web app public config (apps/web)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

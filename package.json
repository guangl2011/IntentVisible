{
  "name": "intentvisible",
  "version": "0.0.0",
  "private": true,
  "description": "Minimal Node.js + TypeScript scaffold verified by CI (lint, typecheck, test, audit).",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"

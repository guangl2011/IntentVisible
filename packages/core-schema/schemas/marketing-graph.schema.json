{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "marketing-graph.schema.json",
  "title": "MarketingGraph",
  "description": "Versioned Stage A output (Pipeline v2 blueprint, 'Output: the Marketing Graph'): brand node, competitor nodes, persona nodes, scenario edges, and intent-topic nodes carrying the three raw scoring dimensions (volume tier, fit, gap). The graph is the single artifact Gate 1 confirms and Stage B's only input. Persona and scenario defs duplicate schemas/persona.schema.json and schemas/scenario.schema.json by design (self-contained files, v1 pattern); contract tests keep the copies in lockstep. Cross-item invariants (referential integrity, id uniqueness, no self-competitor) are enforced by the Zod refinement — JSON Schema cannot express them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph_id",
    "graph_version",
    "brand_id",
    "business_model",
    "value_proposition",
    "moats",
    "competitors",
    "personas",
    "scenarios",
    "intent_topics",
    "data_mode",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/SchemaVersionV2"
    },
    "graph_id": {
      "$ref": "#/$defs/GraphId"
    },
    "graph_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Bumped when a cycle (or a Gate 1 edit) regenerates the graph."
    },
    "brand_id": {
      "$ref": "#/$defs/BrandId"
    },
    "business_model": {
      "$ref": "#/$defs/BusinessModel"
    },
    "value_proposition": {
      "$ref": "#/$defs/Trait"
    },
    "moats": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/Trait"
      },
      "description": "Ingredient/technical moats (Stage A.1)."
    },
    "competitors": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/CompetitorNode"
      },
      "description": "5-10 direct + indirect competitors in the pipeline; schema keeps a loose structural cap (dedup is a generation rule + Zod invariant)."
    },
    "personas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/PersonaNode"
      },
      "description": "3-4 MECE personas in the pipeline; schema keeps loose caps so Gate 1 edits stay valid."
    },
    "scenarios": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/ScenarioEdge"
      }
    },
    "intent_topics": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/IntentTopicNode"
      }
    },
    "data_mode": {
      "$ref": "#/$defs/DataMode",
      "description": "Mode of the graph-generation pass (modeling + estimation). Dimension nodes carry their own data_mode — a graph may legitimately mix an llm_estimated volume with an llm_simulated gap; no measurement exists anywhere in a lightweight graph."
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "SchemaVersionV2": {
      "type": "string",
      "pattern": "^2\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "GraphId": {
      "type": "string",
      "pattern": "^graph_[a-z0-9_]{1,100}$"
    },
    "BrandId": {
      "type": "string",
      "pattern": "^brand_[a-z0-9_]{1,100}$"
    },
    "IntentId": {
      "type": "string",
      "pattern": "^int_[a-z0-9_]{1,100}$"
    },
    "PersonaId": {
      "type": "string",
      "pattern": "^persona_[a-z0-9_]{1,100}$"
    },
    "ScenarioId": {
      "type": "string",
      "pattern": "^scenario_[a-z0-9_]{1,100}$"
    },
    "BusinessModel": {
      "enum": ["dtc", "amazon", "b2b", "affiliate"]
    },
    "BuyerStageV2": {
      "enum": [
        "Awareness",
        "Problem Discovery",
        "Solution Research",
        "Vendor Evaluation",
        "Purchase",
        "Expansion"
      ]
    },
    "IntentCategoryV2": {
      "enum": [
        "Educational",
        "Pain Point",
        "Solution Research",
        "Vendor Comparison",
        "Pricing",
        "ROI",
        "Implementation",
        "Technical",
        "Compliance",
        "Future Trends"
      ]
    },
    "DemandTier": {
      "enum": ["high", "medium", "low"]
    },
    "PriorityTier": {
      "enum": ["S", "A", "B"]
    },
    "CompetitorRelation": {
      "enum": ["direct", "indirect"]
    },
    "DataMode": {
      "enum": ["llm_estimated", "llm_simulated", "provider_measured"]
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "retrieved_at"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Producing source, e.g. 'gemini-2.5-pro' or 'dataforseo'."
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Trait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "assumption", "evidence_urls"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "assumption": {
          "type": "boolean",
          "description": "True when the claim is not stated by the crawled site; uncited claims must be flagged, never silently presented as evidenced."
        },
        "evidence_urls": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "assumption": {
                "const": false
              }
            },
            "required": ["assumption"]
          },
          "then": {
            "properties": {
              "evidence_urls": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "CompetitorNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand_id",
        "name",
        "relation",
        "claims",
        "evidence_urls",
        "data_mode",
        "provenance"
      ],
      "properties": {
        "brand_id": {
          "$ref": "#/$defs/BrandId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "relation": {
          "$ref": "#/$defs/CompetitorRelation"
        },
        "claims": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/Trait"
          },
          "description": "Competitor claims cite the site's own comparison content or are flagged as assumptions."
        },
        "evidence_urls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          }
        },
        "data_mode": {
          "$ref": "#/$defs/DataMode"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      }
    },
    "DemandEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyword", "tier", "monthly_volume", "data_mode", "provenance"],
      "properties": {
        "keyword": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tier": {
          "$ref": "#/$defs/DemandTier"
        },
        "monthly_volume": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Present only when a measured provider filled it; always null in lightweight mode."
        },
        "data_mode": {
          "$ref": "#/$defs/DataMode"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "data_mode": {
                "not": {
                  "const": "provider_measured"
                }
              }
            },
            "required": ["data_mode"]
          },
          "then": {
            "properties": {
              "monthly_volume": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "FitEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "data_mode", "provenance"],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mismatch_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "data_mode": {
          "$ref": "#/$defs/DataMode"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "score": {
                "exclusiveMaximum": 0.5
              }
            },
            "required": ["score"]
          },
          "then": {
            "required": ["mismatch_reason"]
          }
        }
      ]
    },
    "GapEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["void_rate_pct", "data_mode", "provenance"],
      "properties": {
        "void_rate_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Share of spot-check answers recommending no monitored competitor."
        },
        "data_mode": {
          "$ref": "#/$defs/DataMode"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      }
    },
    "IntentTopicNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent_id",
        "intent_name",
        "buyer_stage",
        "intent_category",
        "volume",
        "fit",
        "gap",
        "priority",
        "evidence_urls"
      ],
      "properties": {
        "intent_id": {
          "$ref": "#/$defs/IntentId"
        },
        "intent_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "buyer_stage": {
          "$ref": "#/$defs/BuyerStageV2"
        },
        "intent_category": {
          "$ref": "#/$defs/IntentCategoryV2"
        },
        "volume": {
          "$ref": "#/$defs/DemandEstimate"
        },
        "fit": {
          "$ref": "#/$defs/FitEstimate"
        },
        "gap": {
          "$ref": "#/$defs/GapEstimate"
        },
        "priority": {
          "$ref": "#/$defs/PriorityTier",
          "description": "Derived from the three dimensions, never authored (Stage A.4)."
        },
        "evidence_urls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          }
        }
      }
    },
    "PersonaNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "persona_id",
        "brand_id",
        "archetype",
        "demographics",
        "core_frustrations",
        "cognitive_biases",
        "decision_triggers",
        "ai_language_fingerprint",
        "data_mode",
        "provenance"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/SchemaVersionV2"
        },
        "persona_id": {
          "$ref": "#/$defs/PersonaId"
        },
        "brand_id": {
          "$ref": "#/$defs/BrandId"
        },
        "archetype": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "demographics": {
          "$ref": "#/$defs/Trait"
        },
        "core_frustrations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/Trait"
          }
        },
        "cognitive_biases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/Trait"
          }
        },
        "decision_triggers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/Trait"
          }
        },
        "ai_language_fingerprint": {
          "$ref": "#/$defs/Trait"
        },
        "data_mode": {
          "$ref": "#/$defs/DataMode"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ScenarioEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "scenario_id",
        "persona_id",
        "brand_id",
        "scenario_type",
        "description",
        "data_mode",
        "provenance"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/SchemaVersionV2"
        },
        "scenario_id": {
          "$ref": "#/$defs/ScenarioId"
        },
        "persona_id": {
          "$ref": "#/$defs/PersonaId"
        },
        "brand_id": {
          "$ref": "#/$defs/BrandId"
        },
        "scenario_type": {
          "enum": ["daily_pain", "acute_trigger", "final_shelf_comparison"]
        },
        "description": {
          "$ref": "#/$defs/Trait"
        },
        "data_mode": {
          "$ref": "#/$defs/DataMode"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}

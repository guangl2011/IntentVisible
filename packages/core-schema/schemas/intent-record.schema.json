{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intent-record.schema.json",
  "title": "IntentRecord",
  "description": "Canonical buyer-intent record for Intent Schema v1. Source of truth: docs/spec/core-intent-engine-spec.html (Data contract section) and docs/plan/buyer-intent-lib-product-plan.md (sections 2.1 and 4.1). Boundary invariant: in standalone generation mode the pipeline cannot emit measured values — measurement_source, visibility_pct and monthly_search_volume are null with measurement_status 'not_measured'; only 'imported' or 'measured' records may carry non-null measured values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_id",
    "intent_version",
    "scope",
    "brand_id",
    "intent_name",
    "buyer_stage",
    "intent_category",
    "country",
    "language",
    "prompts",
    "sku_ids",
    "evidence_urls",
    "generation_method",
    "measurement_status",
    "measurement_source",
    "visibility_pct",
    "monthly_search_volume",
    "confidence"
  ],
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "description": "SemVer of the Intent Schema contract; major version must be 1."
    },
    "intent_id": {
      "$ref": "#/$defs/IntentId",
      "description": "Stable identifier; survives rewording via semantic dedup so re-runs update rather than duplicate."
    },
    "intent_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Bumped on every regeneration of the same intent_id."
    },
    "scope": {
      "enum": ["brand", "product"],
      "description": "Brand-level or product-level intent."
    },
    "brand_id": {
      "$ref": "#/$defs/BrandId"
    },
    "intent_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "buyer_stage": {
      "$ref": "#/$defs/BuyerStage"
    },
    "intent_category": {
      "$ref": "#/$defs/IntentCategory"
    },
    "persona": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Target buyer persona (plan section 2.1, inherited from Solix)."
    },
    "pain_point": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2 market."
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}$",
      "description": "ISO 639-1 language code."
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "description": "Natural-language buyer prompts; may be multi-language per market."
    },
    "recommended_content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "recommended_cta": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sku_ids": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/SkuId"
      },
      "description": "Related SKUs; typically empty for brand-scope intents. Authoritative SKU linkage lives in SkuIntentMapping."
    },
    "evidence_urls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https?://"
      },
      "description": "Page evidence this record was derived from; every record carries at least one URL."
    },
    "generation_method": {
      "$ref": "#/$defs/GenerationMethod"
    },
    "generation_model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Model identifier and version that produced the record, when LLM-generated."
    },
    "measurement_status": {
      "$ref": "#/$defs/MeasurementStatus"
    },
    "measurement_source": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 200,
      "description": "Origin of measured values (e.g. a Visible import). Must be null when measurement_status is 'not_measured'."
    },
    "visibility_pct": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 100,
      "description": "Measured visibility. Must be null when measurement_status is 'not_measured'."
    },
    "monthly_search_volume": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Third-party measured search volume. Must be null when measurement_status is 'not_measured'."
    },
    "confidence": {
      "$ref": "#/$defs/Confidence",
      "description": "Confidence in page-evidence support for this record — never a conversion prediction (plan section 2.1)."
    },
    "opportunity_type": {
      "enum": ["hypothesis"],
      "description": "Standalone-mode substitute for the measurement-derived revenue/market expansion labels (plan section 2.1)."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the record was generated."
    }
  },
  "$defs": {
    "SchemaVersion": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "IntentId": {
      "type": "string",
      "pattern": "^int_[a-z0-9_]{1,100}$"
    },
    "BrandId": {
      "type": "string",
      "pattern": "^brand_[a-z0-9_]{1,100}$"
    },
    "SkuId": {
      "type": "string",
      "pattern": "^sku_[a-z0-9_]{1,100}$"
    },
    "BuyerStage": {
      "enum": ["Awareness", "Consideration", "Solution Research", "Comparison", "Purchase Decision"]
    },
    "IntentCategory": {
      "enum": [
        "Category Question",
        "Solution Research",
        "Comparison",
        "Scenario",
        "Price",
        "Risk & Trust",
        "Feature",
        "Compatibility",
        "Purchase Conditions",
        "After-sales",
        "Technical"
      ]
    },
    "GenerationMethod": {
      "enum": ["llm_with_page_evidence", "deterministic_extraction", "imported"]
    },
    "MeasurementStatus": {
      "enum": ["not_measured", "imported", "measured"]
    },
    "Confidence": {
      "enum": ["low", "medium", "high"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "measurement_status": {
            "const": "not_measured"
          }
        },
        "required": ["measurement_status"]
      },
      "then": {
        "properties": {
          "measurement_source": {
            "const": null
          },
          "visibility_pct": {
            "const": null
          },
          "monthly_search_volume": {
            "const": null
          }
        }
      }
    }
  ]
}

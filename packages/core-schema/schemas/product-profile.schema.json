{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "product-profile.schema.json",
  "title": "ProductProfile",
  "description": "Evidence-cited product profile produced by URL extraction (plan M1: JSON-LD/Schema.org Product parsing — title, description, specs, price, variants, FAQ, use cases, compatibility, shipping/returns). Every substantive claim traces to evidence_urls and fetched page snapshots.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_id",
    "brand_id",
    "name",
    "url",
    "features",
    "specifications",
    "use_cases",
    "compatibility",
    "skus",
    "evidence_urls",
    "snapshot_refs",
    "generation_method"
  ],
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "description": "SemVer of the Intent Schema contract; major version must be 1."
    },
    "product_id": {
      "$ref": "#/$defs/ProductId"
    },
    "brand_id": {
      "$ref": "#/$defs/BrandId"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "description": "Product name as evidenced on the page."
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Canonical product detail page URL.",
      "pattern": "^https?://"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "price": {
      "$ref": "#/$defs/Price",
      "description": "Current advertised price, when the page states one."
    },
    "features": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "specifications": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/SpecificationEntry"
      }
    },
    "use_cases": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "compatibility": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "description": "Compatible systems, models, or accessories as evidenced on the page."
    },
    "faqs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/FaqEntry"
      }
    },
    "skus": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/SkuSummary"
      },
      "description": "Variants/SKUs decomposed from the page. May be empty when the PDP does not evidence a SKU split; consumers then treat the product as its own SKU (plan M3)."
    },
    "shipping_and_returns": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "description": "Shipping/returns policies as evidenced on the page."
    },
    "evidence_urls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https?://"
      },
      "description": "Page evidence this profile was derived from; at least one URL."
    },
    "snapshot_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/SnapshotRef"
      },
      "description": "References to stored page snapshots backing the evidence; every extracted profile has at least one."
    },
    "generation_method": {
      "$ref": "#/$defs/GenerationMethod"
    },
    "generation_model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Model identifier and version, when LLM-assisted extraction produced the profile."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the profile was generated."
    }
  },
  "$defs": {
    "SchemaVersion": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "BrandId": {
      "type": "string",
      "pattern": "^brand_[a-z0-9_]{1,100}$"
    },
    "ProductId": {
      "type": "string",
      "pattern": "^product_[a-z0-9_]{1,100}$"
    },
    "SkuId": {
      "type": "string",
      "pattern": "^sku_[a-z0-9_]{1,100}$"
    },
    "GenerationMethod": {
      "enum": ["llm_with_page_evidence", "deterministic_extraction", "imported"]
    },
    "Price": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0,
          "description": "Price in the currency's minor unit is NOT assumed — this is the displayed amount."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 currency code."
        }
      }
    },
    "SpecificationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "FaqEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "answer"],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "SkuSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sku_id"],
      "properties": {
        "sku_id": {
          "$ref": "#/$defs/SkuId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "price": {
          "$ref": "#/$defs/Price"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        }
      }
    },
    "SnapshotRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "content_hash", "fetched_at", "storage_ref"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "content_hash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Content hash of the fetched page (e.g. sha256 hex) — the incremental-refresh key: unchanged hash means regeneration can be skipped."
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time"
        },
        "storage_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Object-storage reference where the snapshot is kept."
        }
      }
    }
  }
}
